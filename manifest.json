{
  "specVersion": 2,
  "id": "io.github.dialogtune.dialog-tune",
  "name": {
    "$t": "plugin.name"
  },
  "version": "1.0.10",
  "entry": "entry.js",
  "author": "Lethivia",
  "description": {
    "$t": "plugin.description"
  },
  "releaseNotes": {
    "$t": "releaseNotes.1_0_10"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "cover": "cover.png",
  "permissions": [
    "generate",
    "input",
    "memory",
    "message",
    "variable"
  ],
  "contributes": {
    "inputActions": [
      {
        "id": "dialog-tune",
        "label": {
          "$t": "actions.dialogTune"
        }
      }
    ],
    "htmlFragments": [
      {
        "id": "dialog-tune-panel",
        "src": "ui/panel.html",
        "mount": "/chat/body/end"
      },
      {
        "id": "dialog-tune-message",
        "src": "ui/message.html",
        "mount": "/messages/end"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": {
            "$t": "settings.info"
          },
          "icon": "info"
        },
        {
          "key": "enabled",
          "type": "switch",
          "label": {
            "$t": "settings.enabled"
          },
          "default": true
        },
        {
          "type": "info",
          "text": {
            "$t": "settings.section.trigger"
          },
          "icon": "info"
        },
        {
          "key": "showInlineButton",
          "type": "switch",
          "label": {
            "$t": "settings.showInlineButton"
          },
          "default": true,
          "description": {
            "$t": "settings.showInlineButton.desc"
          }
        },
        {
          "type": "info",
          "text": {
            "$t": "settings.section.context"
          },
          "icon": "info"
        },
        {
          "key": "defaultUseMemory",
          "type": "switch",
          "label": {
            "$t": "settings.defaultUseMemory"
          },
          "default": false,
          "description": {
            "$t": "settings.defaultUseMemory.desc"
          }
        },
        {
          "key": "defaultRecentN",
          "type": "text",
          "label": {
            "$t": "settings.defaultRecentN"
          },
          "default": "0",
          "description": {
            "$t": "settings.defaultRecentN.desc"
          }
        },
        {
          "key": "maxRecentN",
          "type": "text",
          "label": {
            "$t": "settings.maxRecentN"
          },
          "default": "50",
          "description": {
            "$t": "settings.maxRecentN.desc"
          }
        },
        {
          "type": "info",
          "text": {
            "$t": "settings.section.behavior"
          },
          "icon": "info"
        },
        {
          "key": "guidePrompt",
          "type": "textarea",
          "label": {
            "$t": "settings.guidePrompt"
          },
          "default": {
            "$t": "settings.guidePrompt.default"
          },
          "minLines": 4,
          "maxLines": 12,
          "placeholder": {
            "$t": "settings.guidePrompt.placeholder"
          },
          "description": {
            "$t": "settings.guidePrompt.desc"
          }
        },
        {
          "key": "autoApply",
          "type": "switch",
          "label": {
            "$t": "settings.autoApply"
          },
          "default": false,
          "description": {
            "$t": "settings.autoApply.desc"
          }
        },
        {
          "key": "contentLanguage",
          "type": "select",
          "label": {
            "$t": "settings.contentLanguage"
          },
          "default": "source",
          "options": [
            {
              "value": "source",
              "label": {
                "$t": "settings.contentLanguage.source"
              }
            },
            {
              "value": "app",
              "label": {
                "$t": "settings.contentLanguage.app"
              }
            }
          ],
          "description": {
            "$t": "settings.contentLanguage.desc"
          }
        }
      ]
    },
    "sidebar": [
      {
        "id": "dialog-tune",
        "label": {
          "$t": "actions.dialogTune"
        }
      }
    ]
  },
  "minAppVersion": "0.93.0"
}
